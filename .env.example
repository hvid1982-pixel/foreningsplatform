# -----------------------------------------------------------------------------
# Foreningsplatform – environment variables
# Copy to `.env` for local development:  cp .env.example .env
# NEVER commit real values. In Vercel, set these under Project → Settings →
# Environment Variables.
# -----------------------------------------------------------------------------

# development | test | staging | production
# Seeding demo data is refused when APP_ENV=production.
APP_ENV=development

# PostgreSQL connection string.
# Local (docker compose):  postgres://foreningsplatform:foreningsplatform@localhost:5432/foreningsplatform
# Supabase (Vercel):       use the "Transaction pooler" URL (port 6543).
DATABASE_URL=postgres://foreningsplatform:foreningsplatform@localhost:5432/foreningsplatform

# Separate database used by `pnpm test` (it is wiped between test runs).
TEST_DATABASE_URL=postgres://foreningsplatform:foreningsplatform@localhost:5432/foreningsplatform_test

# Secret used to sign sessions. At least 32 characters.
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# Public URL of the app. Leave empty on Vercel (derived from VERCEL_* variables).
BETTER_AUTH_URL=http://localhost:3000

# E-mail delivery: `smtp` sends real mail, `log` writes mails (incl. links) to the server log.
# Local docker compose runs Mailpit: SMTP on localhost:1025, web inbox on http://localhost:8025
EMAIL_TRANSPORT=smtp
EMAIL_FROM="Foreningsplatform <no-reply@foreningsplatform.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Password given to the seeded DEMO users. Required when APP_ENV is not development/test.
SEED_DEMO_PASSWORD=

# Vercel build hooks (set only in Vercel):
#   RUN_MIGRATIONS_ON_BUILD=true  → apply pending migrations during `pnpm vercel-build`
#   SEED_ON_BUILD=true            → (re)create DEMO data during the build (never in production)
RUN_MIGRATIONS_ON_BUILD=false
SEED_ON_BUILD=false
